data/chroma/
data/chroma_pc/
data/sources/
data/sources_manifest.yaml
data/issues/
data/library.db
data/eval.duckdb
data/eval.duckdb.wal
data/tables_debug/
data/figures/
data/wiki/
data/graph/
data/skeleton/
data/exports/

